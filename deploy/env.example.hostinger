# .env de produção da VPS (Hostinger, Docker Manager) para deploy/docker-compose.hostinger.yml.
# Ao usar: renomeie para .env no diretório do projeto no gerenciador (ex.: /docker/empiremuse) e preencha os valores.
# Nunca versione o .env preenchido.
# Regras do formulário de .env da Hostinger: cada valor com até 256 caracteres e sem comentário na mesma linha do valor.
# Só segredos ficam aqui; a configuração sem segredo fica inline no compose.

# Tokens dos bots do Discord: um por variável (o pool lê TOKEN, TOKEN_2, ... TOKEN_5).
TOKEN=
TOKEN_2=
TOKEN_3=
TOKEN_4=
TOKEN_5=

# IDs dos donos do bot, separados por || (sem eles o jishaku não carrega).
OWNER_IDS=

# URL de conexão do MongoDB (ex.: Atlas).
MONGO=

# Credenciais do Spotify (metadados).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Credenciais do Last.fm (scrobble).
LASTFM_KEY=
LASTFM_SECRET=

# Painel web: aplicação OAuth2 do Discord e segredo dos cookies de sessão.
PANEL_OAUTH_CLIENT_ID=
PANEL_OAUTH_CLIENT_SECRET=
PANEL_COOKIE_SECRET=

# Segredo do relé do RPC (Rich Presence).
RPC_SERVER_SECRET=

# Refresh token do OAuth do YouTube para o Lavalink local (docs/guides/youtube-oauth.md).
YOUTUBE_OAUTH_REFRESH_TOKEN=

# Webhooks do Discord: entrada/saída de servidores e relatórios de erro.
BOT_ADD_REMOVE_LOG=
ERROR_REPORT_WEBHOOK=
AUTO_ERROR_REPORT_WEBHOOK=

# Endereço público do painel e do RPC. SÓ para deploy/docker-compose.hostinger-sem-traefik.yml (o hostinger.yml com Traefik já traz o
# endereço inline): são obrigatórios lá, sem eles o compose não sobe. Use o endereço do SEU proxy, nunca o de outra instância.
# Exemplos: PANEL_BASE_URL=https://painel.exemplo.com  e  RPC_PUBLIC_URL=wss://painel.exemplo.com/ws
PANEL_BASE_URL=
RPC_PUBLIC_URL=

# Auto-update (docs/guides/auto-update.md): GID do grupo dono de /var/run/docker.sock no host. Descubra com
#   stat -c %g /var/run/docker.sock
# e tire o '#' da linha abaixo com o número. É obrigatório enquanto o serviço updater-proxy existir no compose (sem ele,
# o compose se recusa a subir); só o proxy recebe esse grupo, nunca o bot. Valor numérico, não é um segredo.
# DOCKER_GID=
