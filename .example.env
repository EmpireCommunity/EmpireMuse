#########################################################################
### Atenção, para usar este arquivo, você deve renomeá-lo para .env   ###
### Caso use espaço em algum valor, sempre deixe o valor entre aspas! ###
#########################################################################

##########################################################################################################
### TOKEN do bot (Obrigatório)                                                                         ###
### Nota: Você pode incluir bots extras apenas adicionando mais tokens no value (separando com espaço) ###
### ou criando uma config com um nome qualquer (com apenas  letras/números/underline) e no valor       ###
### coloque o(s) token(s) (separado com espaços caso inclua mais de 1 no value).                       ###
###                                                                                                    ###
### Exemplos:                                                                                          ###
### TOKEN='bbbbbbbbbcccDASDSAdeefff.gggghhhhiiii'                                                      ###
### MYBOT='asdsadbbc2cDASDSAdeef3ff.adew234411ax'                                                      ###
###                                                                                                    ###
### Exemplos com múltiplos tokens no value (separando com espaço):                                     ###
### TOKEN='aaabbbbbccccddddeeeefff.gggghhhhiiii aaabbbbb324234dddeeeefff.gggghhhhiiii'                 ###
### MYBOT='bbbbbbbbbcccDASDSAdeefff.gggghhhhiiii 213bbabscccddeeeefff.gggghhhhiiii'                    ###
### COOLBOT='bbbbbbbbbcccDASDSAdeefff.gggghhhhiiii 213bbabscccddeeeefff.gggghhhhiiii'                  ###
##########################################################################################################

# token do(s) bot(s) abaixo (separe com espaço caso adicione mais de 1 token)
TOKEN=''

# Prefixo padrão do bot
DEFAULT_PREFIX='!!'

# Baixar automaticamente uma lista de servidores lavalink públicos.
# Caso hospede em ambientes com recursos restritos (CPU/RAM/tráfego limitados)
# recomendo deixar esta configuração como true.
AUTO_DOWNLOAD_LAVALINK_SERVERLIST=false

# URL de conexão do MongoDB (ex: mongodb+srv://... ou mongodb://...). Se omitido, o bot utiliza persistência local com TinyMongo.
MONGO=''

# Salvar dados de sessões dos players ativos no mongodb (Campo MONGO deve estar configurado).
# Caso esteja false os dados serão salvos na database local (json).
PLAYER_SESSIONS_MONGODB=false

# Emitir aviso sobre dados sensíveis que podem ser armazenados em hosts que deixam source pública.
SENSITIVE_INFO_WARN=true

##############################################
### Sistema de música - Suporte ao spotify ###
##############################################

# Usar key própria ao invés de uma key de visitante obtida automaticamente.
# Caso tenha duvida de como obter os dados para os campos abaixo, veja o tutorial: https://github.com/EmpireCommunity/EmpireMuse/blob/main/docs/guides/spotify-keys.md
SPOTIFY_CLIENT_ID=''
SPOTIFY_CLIENT_SECRET=''

# Definir limite da quantidade de páginas adicionais das playlists para carregar músicas do spotify além do limite das 100 primeiras músicas
# Cada página corresponde a 100 músicas adicionais (recomendo não aumentar muito pois cada página será feita uma requisição extra na api do spotify).
SPOTIFY_PLAYLIST_EXTRA_PAGE_LIMIT=0

###############
### Intents ###
###############
BANS_INTENT='false'
DM_MESSAGES_INTENT='false'
DM_REACTIONS_INTENT='false'
DM_TYPING_INTENT='false'
GUILD_MESSAGES_INTENT='true'
GUILD_REACTIONS_INTENT='false'
GUILD_SCHEDULED_EVENTS_INTENT='false'
GUILD_TYPING_INTENT='false'
EMOJIS_AND_STICKERS_INTENT='true'
INTEGRATIONS_INTENT='true'
INVITES_INTENT='true'
VOICE_STATES_INTENT='true'
WEBHOOKS_INTENT='false'

##########################
### Privileged Intents ###
##########################
PRESENCES_INTENT='false'
MESSAGE_CONTENT_INTENT='true'

##############################
### Outros itens opcionais ###
##############################

# ID de usuário pra lista de owner/dono do bot, caso use mais de 1 id separe por || (Qualquer id que for colocado na lista vai permitir o membro ter acesso total ao bot, tome cuidado!).
OWNER_IDS=''

# Forçar finalizar execução do bot ao dar erro 429 (too many requests)
KILL_ON_429=true

# Ativar cooldown nos comandos (recomendo que deixa false/desativado apenas se o bot for usado em servidores de amigos ou pequenos)
# pois o uso incontrolável de comandos em intervalo muito curto de segundos em comandos como o skip pode fazer com que
# seus servidores lavalink tomem ratelimit mais rápido das plataformas de música etc
ENABLE_COMMANDS_COOLDOWN=true

# Ativar/Desativar log de comandos (só de quem não é dono do bot). Ligado, cada comando registra o ID do usuário, o ID do
# servidor, o comando e as opções resumidas por tipo (membro e mensagem só pelo ID, anexo só pelo tipo e tamanho, texto livre
# só pelo tamanho; nunca nome, apelido nem link de anexo; exceção: nos servidores de LOG_DEBUG_GUILDS o texto livre, inclusive
# o de comandos de prefixo, sai também em INFO, truncado e redigido) em nível INFO: sai no console quando o INFO está
# habilitado (LOG_LEVEL=DEBUG ou INFO) e também no arquivo .logs/disnake.log quando o arquivo está ligado, ou seja, com
# LOG_FILE=on, ou LOG_FILE=auto com ENABLE_LOGGER=true, ou LOG_FILE=auto fora da imagem Docker.
# Os IDs ainda são dados pessoais dos usuários (LGPD): fica desligado por padrão, ligue só se precisar e pelo tempo necessário.
COMMAND_LOG=false

# invite do servidor de suporte (exibido no comando about e nos erros dos comandos).
# Nota para quem hospeda a própria instância: troque pelo convite do seu próprio servidor ou deixe vazio (SUPPORT_SERVER='') para não exibir o link.
SUPPORT_SERVER='https://discord.gg/KgtyNg9U6H'

# Perfil da aplicação no Discord (descrição e tags): cada bot grava o próprio perfil ao iniciar, só se diferir do valor abaixo.
# Vazio (APP_DESCRIPTION='' / APP_TAGS='') = não mexer nesse campo. A descrição aceita {prefix} (DEFAULT_PREFIX), {bots} (quantos
# bots no pool; some com um bot só), {panel_url} (PANEL_BASE_URL + /painel, com o painel ligado), {support_url} (SUPPORT_SERVER) e
# {main} (nome do bot principal, o do TOKEN): a linha cujo marcador fica vazio sai. Use \n para quebrar a linha. Limites do Discord:
# descrição até 400 caracteres (passou, é encurtada com um aviso) e até 5 tags de até 20 caracteres, separadas por vírgula (as
# inválidas saem com um aviso).
APP_DESCRIPTION='🎵 Bot de música da comunidade EmpireHub: YouTube, Spotify e Deezer.\n▶️ Comece com /play ou {prefix}play <nome ou link>. Ajuda: {prefix}help\n🤖 Somos {bots} bots: se eu estiver ocupado, uma reserva entra na sua call.\n⚙️ Painel: {panel_url}\n💬 Suporte: {support_url}'
# Descrição dos bots RESERVA (todos menos o do TOKEN), com os mesmos marcadores. Vazio = não mexer na descrição das reservas.
APP_DESCRIPTION_RESERVE='🎵 Reserva do {main}: entro na call quando o {main} está ocupado.\n▶️ Comandos de barra ficam no {main}; aqui use {prefix}play. Ajuda: {prefix}help\n⚙️ Painel: {panel_url}\n💬 Suporte: {support_url}'
APP_TAGS='música,music,player,spotify,youtube'

# Sincronizar comandos automaticamente ao ligar o bot.
AUTO_SYNC_COMMANDS=true

# Link do webhook para envio de logs quando o bot for adicionado/removido de um server.
BOT_ADD_REMOVE_LOG=''

# ID do canal para envio de logs quando o bot for adicionado/removido de um server.
BOT_ADD_REMOVE_LOG_CHANNEL_ID='0'

# Link do webhook para envio dos reports de erros (será ignorado caso seja usado o AUTO_ERROR_REPORT_WEBHOOK).
ERROR_REPORT_WEBHOOK=''

# Link do webhook para envio dos reports de erros automático
# Aviso: é altamente recomendável que o canal que vai receber estes logs seja privado para os devs do bot
# por estar sujeito a exbir informações confidenciais como keys da env/secret etc.
AUTO_ERROR_REPORT_WEBHOOK=''

# cor da embed do player: hex de 6 dígitos, sem '#' (padrão: violeta do EmpireMuse).
# Use 'none' para usar a cor do cargo do bot.
EMBED_COLOR=8B5CF6

# Link do github pra ser usado em comandos como o de update.
SOURCE_REPO='https://github.com/EmpireCommunity/EmpireMuse.git'

# Não permitir o uso dos comandos de texto com prefixo.
INTERACTION_COMMAND_ONLY=false

# Carregar o jishaku (comandos de owner para executar código Python e shell pelo Discord).
# Fica desligado por padrão; ligue só se você precisa dele e confia em quem está em OWNER_IDS.
ENABLE_JISHAKU=false

# Tempo em segundos para alterar a presence do bot.
PRESENCE_INTERVAL=900

# ID de permissões para incluir no convite do bot (padrão: 2533601240804560).
# Permissões: READ_MESSAGE_HISTORY, VIEW_CHANNEL, SEND_MESSAGES, EMBED_LINKS, ATTACH_FILES,
# ADD_REACTIONS, USE_EXTERNAL_EMOJIS, CONNECT, SPEAK, MUTE_MEMBERS, DEAFEN_MEMBERS, MOVE_MEMBERS,
# MANAGE_CHANNELS, MANAGE_MESSAGES, PIN_MESSAGES, MANAGE_THREADS, CREATE_PUBLIC_THREADS,
# SEND_MESSAGES_IN_THREADS, VIEW_AUDIT_LOG, SET_VOICE_CHANNEL_STATUS.
INVITE_PERMISSIONS=2533601240804560

# Ativar/Desativar log/debug do bot (legado: ENABLE_LOGGER=true equivale a LOG_FILE=on; veja LOG_FILE abaixo).
ENABLE_LOGGER=false

# Nível do log do console e do arquivo: DEBUG, INFO, WARNING ou ERROR. Em INFO só saem problemas e o resumo periódico.
# DEBUG global é temporário: com muitos servidores ele gira o arquivo em minutos. Prefira LOG_DEBUG_GUILDS.
LOG_LEVEL=INFO

# Cores no console: on ou off. A variável NO_COLOR (qualquer valor não vazio) também desliga.
LOG_COLOR=on

# Arquivo de log rotativo (.logs/disnake.log, 5 MB x 3): auto (ligado fora do Docker, desligado no Docker), on ou off.
LOG_FILE=auto

# IDs de servidores (separados por vírgula, no máximo 50) cujo detalhe (DEBUG) deve aparecer mesmo com LOG_LEVEL=INFO.
LOG_DEBUG_GUILDS=

# Intervalo, em segundos, do resumo periódico de métricas no log (de 1 a 59 vira 60). O 0 desliga só o resumo: a manutenção
# do log (fechar as janelas de repetidos) segue a cada 60 segundos.
METRICS_INTERVAL=300

# Dias de retenção do registro de uso (onde, como e quando o bot foi usado: servidor, canal, comando e faixa; nunca quem usou).
# De 1 a 365; valor inválido ou menor que 1 usa 30. No MongoDB a retenção é um índice TTL; no banco local, uma poda a cada hora.
USAGE_RETENTION_DAYS=30

# Emojis do aplicativo: sincronizados só com os bots principais. Com true, sincroniza também os bots por servidor do
# guild_bots.json, que podem ser aplicativos de outras pessoas.
APP_EMOJIS_GUILD_BOTS=false

# Diretório padrão para ser usado no git
GIT_DIR="./.git"

# Socket do proxy de atualização (só no deploy Docker com o auto-update; caminho ABSOLUTO ou vazio).
# Com ele, o comando /update atualiza o bot sozinho pelo auxiliar do proxy; sem ele, o bot só informa a nova versão.
# Caminho relativo é ignorado com um aviso.
UPDATE_PROXY_SOCKET=''

#########################
### Sistema de música ###
#########################

# Avisar quando o bot não tiver com audio desativado no servidor.
GUILD_DEAFEN_WARN=true

# Link para baixar a lista de servidores lavalink (lavalink.ini)
LAVALINK_SERVER_LIST='https://raw.githubusercontent.com/EmpireCommunity/EmpireMuse/main/data/lavalink_servers.ini'

# Número de tentativas para reconectar em um servidor lavalink (0 = sem limite; aceita qualquer valor >= 0).
LAVALINK_RECONNECT_RETRIES=30

# Forçar o uso do client interno do deezer (no caso a requisião de links do deezer será ignorada no lavalink server caso o mesmo tenha suporte).
FORCE_USE_DEEZER_CLIENT=false

# limite de favoritos por membro (0 ou menor que isso = sem limites)
MAX_USER_FAVS=10

# limite de caracteres no nome de playlists/favoritos (funciona como teto adicional; vale o menor entre o configurado e 25).
USER_FAV_MAX_NAME_LENGTH=35

# limite de caracteres no link de playlists.
USER_FAV_MAX_URL_LENGTH=90

# Tempo em segundos pro bot aguardar por novas músicas no modo de espera.
IDLE_TIMEOUT=180

# Tempo em segundos pro bot aguardar membros entrarem no canal de voz quando estiver vazio.
WAIT_FOR_MEMBERS_TIMEOUT=180

# skin padrão do player no modo normal (você pode copiar a skin padrão e deixa-la com outro nome e editar o arquivo a seu gosto, ela não será afetada por minhas alterações em updates das skins originais).
DEFAULT_SKIN='default'

# skin padrão do player no modo song-request (você pode copiar a skin padrão e deixa-la com outro nome e editar o arquivo a seu gosto, ela não será afetada por minhas alterações em updates das skins originais).
DEFAULT_STATIC_SKIN='default'

# ignorar skins da lista do modo normal (nome do arquivo sem .py e caso tenha mais de 1 separe por espaço)
IGNORE_SKINS=''

# ignorar skins da lista do modo song-request (nome do arquivo sem .py e caso tenha mais de 1 separe por espaço)
IGNORE_STATIC_SKINS=''

# Incluir dicas adicionais no player (não use quebra de linha e caso inclua mais de uma você deve separar com ||)
EXTRA_HINTS=""

# Taxa de exibição de dicas no player (quanto maior o valor menor será a chance). Mínimo: 1 (0 ou menos vira 1).
HINT_RATE=4

# quantidade de votos necessários para o comando de voteskip. Mínimo: 1 (0 ou menos vira 1).
VOTE_SKIP_AMOUNT=3

# tempo de espera para limpeza de dados do evento pool_payload_ready.
PREFIXED_POOL_TIMEOUT=4

# Ativar suporte a links (e anexos) do discord em comandos de adicionar música.
ENABLE_DISCORD_URLS_PLAYBACK=true

# Intervalo (em segundos) para salvar informações do player na database (mínimo: 30).
PLAYER_INFO_BACKUP_INTERVAL=45

# Tempo de espera (em segundos) para aguardar resposta do mongodb. Mínimo: 1 (0 ou menos vira 1).
MONGO_TIMEOUT=30

# Intervalo (em segundos) para salvar informações do player na database do mongodb (mínimo: 120).
PLAYER_INFO_BACKUP_INTERVAL_MONGO=300

# Quantidade máxima permitida de músicas na fila (0 = ilimitado)
QUEUE_MAX_ENTRIES=0

# Ativar typing ao usar defer em alguns comando prefixed.
ENABLE_DEFER_TYPING=true

# Ping mínimo para o bot reconectar no canal de voz (em situações de instabilidade)
VOICE_CHANNEL_LATENCY_RECONNECT=200

# Quantidade de itens para armazenar info de playlists no cache interno. Mínimo: 1 (0 ou menos vira 1).
PLAYLIST_CACHE_SIZE=500

# Duração de armazenamento das info de playlists no cache interno (em segundos).
PLAYLIST_CACHE_TTL=1800

# Ativar/Desativar pedido de música via menção do bot
ENABLE_SONGREQUEST_MENTION=true

################################################
### Sistema de música - RPC (Rich Presence): ###
################################################

# Ativar/Desativar servidor RPC/Página WEB interno.
RUN_RPC_SERVER=false

# Ativar/Desativar o comando para gerar token e exibir o link para usar no app de rich presence (true ou false)
ENABLE_RPC_COMMAND=false

# Link do servidor RPC (pra status do membro), caso não tenha será usado localmente.
RPC_SERVER='ws://localhost:$PORT/ws'

# Link para ser exibido no comando /rich_presence.
# Nota: caso não seja informado será exibido o link do RPC_SERVER (caso considere o url informado no RPC_SERVER seja
# acessível para membros você pode deixar o campo abaixo vazio).
RPC_PUBLIC_URL=''

# Ativar/Desativar autenticação via token para ter acesso ao RPC (false ou true).
# O padrão é true: só desative em rede privada e sem expor a porta (o servidor registra um aviso se escutar em
# 0.0.0.0 com a autenticação desligada).
ENABLE_RPC_AUTH=true

# Segredo que o bot usa para se registrar no servidor RPC (cabeçalho X-RPC-Key).
# Vazio: o bot e o servidor RPC do mesmo processo usam um segredo gerado automaticamente a cada inicialização.
# Defina o MESMO valor nos dois lados quando o servidor RPC rodar em outra instância. Trate como senha e use wss://.
RPC_SERVER_SECRET=''

# Origens de navegador autorizadas a abrir o WebSocket do RPC, separadas por vírgula (ex.: https://painel.exemplo.com).
# Vazio: só clientes sem cabeçalho Origin (app, bot) e a mesma origem do servidor são aceitos.
RPC_ALLOWED_ORIGINS=''

# Endereço de escuta do servidor web/RPC. 0.0.0.0 aceita conexões de qualquer interface (necessário em Docker e
# Pterodactyl); use 127.0.0.1 para aceitar apenas conexões locais ou um proxy reverso no mesmo host.
# Com 0.0.0.0 e ENABLE_RPC_AUTH=false, um aviso é registrado na inicialização.
WEB_BIND_ADDRESS=0.0.0.0

#######################################
### Painel web (gerenciamento web) ####
#######################################
# O painel roda no mesmo servidor web do RPC, sob /painel, e só sobe junto com ele: exige RUN_RPC_SERVER=true.
# Login pela aplicação do Discord do EmpireMuse 1. No Developer Portal (OAuth2 > Redirects) cadastre exatamente:
# <PANEL_BASE_URL>/painel/callback   (ex.: http://localhost:6000/painel/callback)

# Ativar/Desativar o painel web (true ou false).
PANEL_ENABLED=false

# URL pública do painel, sem caminho (ex.: https://painel.seudominio.com ou http://localhost:6000).
# Obrigatória com o painel ativo; HTTPS é obrigatório, exceto em localhost com PANEL_INSECURE_COOKIES=true.
PANEL_BASE_URL=''

# Client ID da aplicação OAuth2 (vazio = usa a aplicação do primeiro bot).
PANEL_OAUTH_CLIENT_ID=''

# Client Secret da aplicação OAuth2 (obrigatório com o painel ativo). NUNCA versione este valor.
PANEL_OAUTH_CLIENT_SECRET=''

# Segredo para assinar cookies (mínimo de 32 caracteres). Vazio = gerado a cada inicialização
# (as sessões deixam de valer ao reiniciar). NUNCA versione este valor.
PANEL_COOKIE_SECRET=''

# Duração máxima da sessão (1 a 168 horas) e tempo de ociosidade até expirar (5 a 1440 minutos).
PANEL_SESSION_TTL_HOURS=12
PANEL_SESSION_IDLE_MINUTES=60

# Ative somente atrás de proxy reverso confiável (usa X-Forwarded-* para IP/protocolo). Atrás da Cloudflare, o IP do visitante
# vem do cabeçalho CF-Connecting-IP (quando válido); por isso só ligue se o proxy aceitar APENAS conexões da Cloudflare (ou, se não for a Cloudflare, remova o CF-Connecting-IP recebido do cliente).
PANEL_TRUST_PROXY=false

# Apenas para desenvolvimento em http://localhost: permite cookies sem o atributo Secure.
PANEL_INSECURE_COOKIES=false

# Cooldown para usar comandos referente a skip com tracks do youtube (pra ajudara a prevenir possíveis bloqueios do yt e flood intencional do uso do comando),
YOUTUBE_TRACK_COOLDOWN=20

##################################################
### Sistema de música - Local lavalink stuffs: ###
##################################################

# Forçar inicialização do servidor lavalink local (Nota: Iniciar servidor lavalink na mesma instância do bot
# requer uma vps/host com 512mb de ram no mínimo, caso não esteja ativado ignore todos os itens relacionados ao lavalink abaixo.
# IMPORTANTE para usuários de Docker: NÃO descomente este item — a imagem oficial já define RUN_LOCAL_LAVALINK=true
# via variável de ambiente da imagem. Se descomentado como false aqui, o .env sobrescreverá a imagem e desligará o Lavalink.
# Fora do Docker: descomente e altere para true para executar o Lavalink embutido.
# RUN_LOCAL_LAVALINK=false

# Conectar com lavalink local
CONNECT_LOCAL_LAVALINK=true

# Preferir o uso do suporte nativo do youtube ao invés de tentar buscar a mesma música em outras plataformas
PREFER_YOUTUBE_NATIVE_PLAYBACK=true

# Registrar apenas provedores de busca que tem suporte a reprodução nativa.
ONLY_USE_NATIVE_SEARCH_PROVIDERS=true

# provedores de busca padrão (separe com espaço para múltiplos itens preservando as aspas originais).
# Nota: Caso queira desativar o suporte ao youtube você pode remover o ytsearch ou ytmsearch da lista abaixo (separando com espaço).
SEARCH_PROVIDERS="ytsearch ytmsearch scsearch"

# Tempo adicional pra aguardar o servidor lavalink iniciar (atualmente não é muito necessário e talvez em breve irei retirar).
LAVALINK_ADDITIONAL_SLEEP=0

# Quantidade de ram inicial pra ser usado no processo do servidor lavalink.
LAVALINK_INITIAL_RAM=30

# Limite de ram pra ser usado no processo do servidor lavalink.
LAVALINK_RAM_LIMIT=120

# Quantidade de cpu cores pra ser usado no servidor lavalink.
LAVALINK_CPU_CORES=1

# Link para baixar o Lavalink.jar. Vazio (o padrão) = espelho oficial da versão deste código, atualizado junto com o bot.
# Só preencha para usar um jar próprio: nesse caso o endereço precisa ser HTTPS e LAVALINK_FILE_SHA256 é obrigatório.
LAVALINK_FILE_URL=

# SHA-256 do Lavalink.jar. Obrigatório apenas se você trocar LAVALINK_FILE_URL por outro endereço
# (o jar oficial usa o hash fixo do projeto). Sem o hash, o download de um endereço diferente é recusado.
LAVALINK_FILE_SHA256=

# SEGREDO — não compartilhe, não versione e não publique este valor. Refresh token OAuth do YouTube (cliente TV) para o
# Lavalink local contornar o bloqueio anti-bot ("Sign in to confirm you're not a bot"). Use SEMPRE uma conta Google
# descartável (nunca a sua conta pessoal): o YouTube pode restringir a conta. Vazio = OAuth desligado. O bot entrega o
# valor ao Lavalink apenas pelo ambiente do processo, sem gravá-lo em arquivo nem em log.
YOUTUBE_OAUTH_REFRESH_TOKEN=


# Container com Lavalink pré-instalado (todos opcionais; vazio/false = comportamento normal, com download).
# IMPORTANTE para usuários de Docker: NÃO descomente estes itens — a imagem oficial já define em seu ambiente:
#   LAVALINK_JAVA_PATH=/opt/java/openjdk/bin/java
#   LAVALINK_HOME=/opt/lavalink
#   LAVALINK_OFFLINE=true
# Se descomentados como vazios ou false aqui, o .env sobrescreverá a imagem, quebrando a inicialização do container.
# Fora do Docker: descomente apenas se utilizar binários pré-instalados ou container customizado.
# Caminho completo do executável do Java (17+) já instalado. Vazio = usa o java do sistema ou instala o JDK.
# LAVALINK_JAVA_PATH=
#
# Pasta com Lavalink.jar, application.yml e plugins/ (pode ser somente leitura no modo offline). Vazio = pasta de dados do bot.
# LAVALINK_HOME=
#
# true = não baixa nada: só confere o SHA-256 dos arquivos pré-instalados e recusa iniciar se faltar ou divergir.
# LAVALINK_OFFLINE=false

##################################################
### Sistema de música - Integração com Last.fm ###
##################################################

# Você pode obter esses dados acessando o link: https://www.last.fm/api
LASTFM_KEY=''
LASTFM_SECRET=''

####################################################################################################################
##### Bot presences:                                                                                           #####
##### Status pra exibir no bot, caso queira mais de 1 pra tipo específico separe com ||                        #####
#####                                                                                                          #####
##### Placeholders:                                                                                            #####
##### {users} -> quantidade de usuários.                                                                       #####
##### {guilds} -> quantidade de servidores.                                                                    #####
##### {playing} -> quantidade de players ativos.                                                               #####
##### {uptime} -> uptime do bot.                                                                               #####
##### {owner} -> nick/nome do dono do bot (ou da team).                                                        #####
#####                                                                                                          #####
##### Sobre os placeholders abaixo, o texto inteiro que tivé-los será ignorado caso a contagem seja zero.      #####
#####                                                                                                          #####
##### {players_count} -> quantidade de players ativos.                                                         #####
##### {players_count_allbotchannels} -> quantidade de players ativos somando todos os canais em todos os bots. #####
##### {players_count_allbotservers} -> quantidade de players ativos somando todos os servidores em todos       #####
##### os bots sem duplicar contagem caso mais de 1 bot esteja no mesmo servidor).                              #####
#####                                                                                                          #####
##### Ex: estou online há {uptime} || tocando música em {playing} servidores                                   #####
####################################################################################################################
LISTENING_PRESENCES=''
WATCHING_PRESENCES=''
PLAYING_PRESENCES=''
CUSTOM_STATUS_PRESENCES='🎵 /play ou !play | ajuda: !help||⚙️ Painel: muse.empirecommunity.org/painel||🎧 Tocando em {players_count} calls'

# Nota: para o formato de streaming você deve informar o nome e url (twich ou do yt) separando com ||
# Ex: Demonstração dos meus comandos || https://www.youtube.com/watch?v=OsJYB2W199k
# Para mais de uma opção de streaming você pode separar cada grupo usando |||
# Ex: Demonstração dos meus comandos || https://www.youtube.com/watch?v=OsJYB2W199k ||| Twin Saga runs || https://www.youtube.com/watch?v=sU-fmPFHzKA
STREAMING_PRESENCES=''

